From e17188fefacb923e4e3351f6689e1774cbc9e79c Mon Sep 17 00:00:00 2001
From: Julien Maille <julien.maille@gmail.com>
Subject: [PATCH] Parser: declaration order companions for functions, typeAliases and variables

Fixes #2. Fixes #4. The four accessors of _ScopeModelItem returned the
values() of QHash containers, whose order changes with the per-process
hash seed: two regens of the same headers emitted classes' members in
different orders, and functionDefinitions() fed the class generator a
member order that moved between runs.

Give functions(), functionDefinitions(), typeAliases() and variables()
order companions next to their name -> item maps, the same pattern the
classes() and enums() fix (6bc3c1a) established: addTypeAlias() and
addVariable() replace the entry in place when the name is added twice,
so the list matches the map's one-item-per-name contract; functions()
and functionDefinitions() are append-only (overloads are distinct
items), deduped by identity and pruned by identity in remove*().

Verified with a standalone probe that parses a header through the real
Parser + Binder and prints the four lists: before the fix, five runs of
the same binary produced five different orders; after, all runs are
identical and match source declaration order.
---
 generator/parser/codemodel.cpp | 74 ++++++++++++++++++++++++++++++++--
 generator/parser/codemodel.h   |  9 +++++
 2 files changed, 79 insertions(+), 4 deletions(-)

diff --git a/generator/parser/codemodel.cpp b/generator/parser/codemodel.cpp
index a8b3f9b..7fa241c 100644
--- a/generator/parser/codemodel.cpp
+++ b/generator/parser/codemodel.cpp
@@ -412,17 +412,17 @@ ClassList _ScopeModelItem::classes() const
 
 TypeAliasList _ScopeModelItem::typeAliases() const
 {
-  return _M_typeAliases.values();
+  return _M_typeAliasOrder;
 }
 
 VariableList _ScopeModelItem::variables() const
 {
-  return _M_variables.values();
+  return _M_variableOrder;
 }
 
 FunctionList _ScopeModelItem::functions() const
 {
-  return _M_functions.values();
+  return _M_functionOrder;
 }
 
 void _ScopeModelItem::addEnumsDeclaration(const QString &enumsDeclaration)
@@ -432,7 +432,7 @@ void _ScopeModelItem::addEnumsDeclaration(const QString &enumsDeclaration)
 
 FunctionDefinitionList _ScopeModelItem::functionDefinitions() const
 {
-  return _M_functionDefinitions.values();
+  return _M_functionDefinitionOrder;
 }
 
 EnumList _ScopeModelItem::enums() const
@@ -524,6 +524,13 @@ void _ScopeModelItem::removeFunction(FunctionModelItem item)
     {
       _M_functions.erase(it);
     }
+
+  for (int i = 0; i < _M_functionOrder.size(); ++i) {
+    if (_M_functionOrder.at(i) == item) {
+      _M_functionOrder.removeAt(i);
+      break;
+    }
+  }
 }
 
 void _ScopeModelItem::removeFunctionDefinition(FunctionDefinitionModelItem item)
@@ -540,6 +547,13 @@ void _ScopeModelItem::removeFunctionDefinition(FunctionDefinitionModelItem item)
     {
       _M_functionDefinitions.erase(it);
     }
+
+  for (int i = 0; i < _M_functionDefinitionOrder.size(); ++i) {
+    if (_M_functionDefinitionOrder.at(i) == item) {
+      _M_functionDefinitionOrder.removeAt(i);
+      break;
+    }
+  }
 }
 
 void _ScopeModelItem::removeVariable(VariableModelItem item)
@@ -548,6 +562,13 @@ void _ScopeModelItem::removeVariable(VariableModelItem item)
 
   if (it != _M_variables.end() && it.value() == item)
     _M_variables.erase(it);
+
+  for (int i = 0; i < _M_variableOrder.size(); ++i) {
+    if (_M_variableOrder.at(i) == item) {
+      _M_variableOrder.removeAt(i);
+      break;
+    }
+  }
 }
 
 void _ScopeModelItem::removeTypeAlias(TypeAliasModelItem item)
@@ -556,6 +577,13 @@ void _ScopeModelItem::removeTypeAlias(TypeAliasModelItem item)
 
   if (it != _M_typeAliases.end() && it.value() == item)
     _M_typeAliases.erase(it);
+
+  for (int i = 0; i < _M_typeAliasOrder.size(); ++i) {
+    if (_M_typeAliasOrder.at(i) == item) {
+      _M_typeAliasOrder.removeAt(i);
+      break;
+    }
+  }
 }
 
 void _ScopeModelItem::removeEnum(EnumModelItem item)
diff --git a/generator/parser/codemodel.h b/generator/parser/codemodel.h
index e0390a3..5b34730 100644
--- a/generator/parser/codemodel.h
+++ b/generator/parser/codemodel.h
@@ -341,6 +341,15 @@ private:
   QHash<QString, VariableModelItem> _M_variables;
   QMultiHash<QString, FunctionDefinitionModelItem> _M_functionDefinitions;
   QMultiHash<QString, FunctionModelItem> _M_functions;
+  // Declaration order of the type aliases, variables, functions and function
+  // definitions, kept next to the name -> item maps: the maps are QHashes and
+  // their values() order changes with the per-process hash seed, which made
+  // two regens of the same headers produce differently ordered output. Same
+  // pattern as _M_classOrder and _M_enumOrder above.
+  TypeAliasList _M_typeAliasOrder;
+  VariableList _M_variableOrder;
+  FunctionList _M_functionOrder;
+  FunctionDefinitionList _M_functionDefinitionOrder;
 
 private:
   _ScopeModelItem(const _ScopeModelItem &other);
-- 
